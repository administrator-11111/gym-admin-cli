classDiagram
    class Imprimible {
        <<interface>>
        +resumenDatos() String
    }
    class Usuario {
        <<abstract>>
        # id: Int
        # nombreCompleto: String
    }
    class Administrador {
        - nombreUsuario: String
        - clave: String
        + validarCredenciales() Boolean
    }
    class Cliente {
        - suscripcionActual: Suscripcion
        + esMoroso() Boolean
    }
    class Suscripcion {
        - tipoPlan: String
        - costo: Doble
        - fechaInicio: Fecha
        - fechaFin: Fecha
        + renovar(meses: Int) Unit
    }
    class Fecha {
        - dia: Int
        - mes: Int
        - anio: Int
        + sumarMeses(n: Int) Unit
    }
    class Gestor {
        - clientes: List~Cliente~
        - administradores: List~Administrador~
        + iniciarSesion(usuario: String, clave: String) Boolean
        + inscribirCliente(cliente: Cliente) Unit
        + quitarcliente(cliente: Cliente) Unit
        + mostrarMorosos() Unit
        + calcularGanancias() Double
    }
    %% Relaciones
    Imprimible <|.. Usuario : implementa
    Usuario <|-- Administrador : hereda
    Usuario <|-- Cliente : hereda
    Cliente --> Suscripcion : tiene
    Suscripcion *-- Fecha : compone
    Gestor o-- Cliente : agrega
    Gestor o-- Administrador : agrega